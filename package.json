{
  "name": "challengeloop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Habit + Challenge Platform",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=api\" \"npm run dev --workspace=client\"",
    "dev:api": "npm run dev --workspace=api",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "build:vercel": "npm run build --workspace=client",
    "install:all": "npm install",
    "start": "node api/index.js"
  },
  "workspaces": [
    "api",
    "client"
  ],
  "engines": {
    "node": ">=18.x"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "jsonwebtoken": "^9.0.0",
    "jwt-simple": "^0.5.6",
    "mongodb": "^7.2.0",
    "mongoose": "^7.0.0",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  }
}
