{
  "buildCommand": "npm install",
  "outputDirectory": "",
  "installCommand": "npm install",
  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ],
  "crons": [
    {
      "path": "/api/leaderboard/reset",
      "schedule": "0 0 * * 0"
    }
  ]
}